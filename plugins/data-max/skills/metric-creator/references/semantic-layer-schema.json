{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "semantic-layer-schema.json",
    "title": "SematicLayer",
    "type": "object",
    "$defs": {
        "Modifier": {
            "type": "object",
            "properties": {
                "$fn"      : {"type": "string"                               },
                "$operands": {                  "$ref": "#/$defs/Expressions"}
            },
            "required": ["$fn"],
            "additionalProperties": false
        },
        "Star": {
            "type": "object",
            "properties": {
                "$table"  : {"type": "string"                                },
                "$not"    : {"type": "boolean"                               },
                "$like"   : {"type": "string"                                },
                "$ilike"  : {"type": "string"                                },
                "$similar": {"type": "string"                                },
                "$glob"   : {"type": "string"                                },
                "$exclude": {                   "$ref": "#/$defs/Expressions"},
                "$replace": {                   "$ref": "#/$defs/Expressions"},
                "$rename" : {                   "$ref": "#/$defs/Expressions"}
            },
            "additionalProperties": false
        },
        "CaseWhen": {
            "type": "object",
            "properties": {
                "$condition": {"$ref": "#/$defs/LogicalExpression"},
                "$expr"     : {"$ref": "#/$defs/Expression"}
            },
            "additionalProperties": false
        },
        "Case": {
            "type": "object",
            "properties": {
                "$cases": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/CaseWhen"}
                },
                "$else": {"$ref": "#/$defs/Expression"}
            },
            "additionalProperties": false
        },
        "Qualifier": {
            "type": "object",
            "properties": {
                "$table"   : {"type": "string" },
                "$schema"  : {"type": "string" },
                "$catalog" : {"type": "string" },
                "$excluded": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "Expressions": {
            "type": "array",
            "items": {"$ref": "#/$defs/Expression"}
        },
        "Expression": {
            "type": "object",
            "properties": {
                "$selectNode": {"$ref": "#/$defs/SetOperation"},
                "$case": {"$ref": "#/$defs/Case"},
                "$identifier": {"type": "string"},
                "$qualifier": {"$ref": "#/$defs/Qualifier"},
                "$quantifier": {"type": "string"},
                "$literal": {"type": "string"},
                "$const": {"type": "string"},
                "$arg": {"type": "string"},
                "$scalar": {
                    "oneOf": [
                        {"type": "string" },
                        {"type": "number" },
                        {"type": "boolean"},
                        {"type": "null"   }
                    ]
                },
                "$var": {
                    "oneOf": [
                        {"type": "string" },
                        {"type": "number" },
                        {"type": "boolean"},
                        {"type": "null"   }
                    ]
                },
                "$distinct": {"type": "boolean"},
                "$null": {"type": "boolean"},
                "$unsafe": {"type": "string"},
                "$collate": { "type": "array", "items": {"type": "string"} },
                "$typedLiteral": {"type": "string"},
                "$cast": {"type": "string"},
                "$shortCast": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/DataType"}
                },
                "$dict": {
                    "type": "object",
                    "additionalProperties": {"$ref": "#/$defs/Expression"}
                },
                "$agg": {"$ref": "#/$defs/Aggregate"},
                "$window": {"$ref": "#/$defs/Window"},
                "$unary": {"$ref": "#/$defs/Unary"},
                "$binary": {"$ref": "#/$defs/Binary"},
                "$variadic": {"$ref": "#/$defs/Variadic"},
                "$concat": {"$ref": "#/$defs/Expressions"},
                "$logical": {"$ref": "#/$defs/LogicalExpression"},
                "$list": {"$ref": "#/$defs/Expressions"},
                "$tuple": {"$ref": "#/$defs/Expressions"},
                "$values": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/Expressions"}
                },
                "$star": {"$ref": "#/$defs/Star"},
                "$columns": {"type": "boolean"},
                "$unpacked": {"type": "boolean"},
                "$as": {"type": "string"},
                "$derivedColumns": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "Predicate": {
            "type": "object",
            "properties": {
                "$left": {"$ref": "#/$defs/Expressions"},
                "$right": {"$ref": "#/$defs/Expressions"},
                "$operator": {
                    "type": "string",
                    "enum": ["=", "!=", ">", ">=", "<", "<="]
                },
                "$quantifier": {"type": "string"}
            },
            "additionalProperties": false
        },
        "LogicalExpression": {
            "type": "object",
            "properties": {
                "$not"         : {"type": "boolean"},
                "$and"         : {"$ref": "#/$defs/LogicalExpressions"},
                "$or"          : {"$ref": "#/$defs/LogicalExpressions"},
                "$xor"         : {"$ref": "#/$defs/LogicalExpressions"},
                "$like"        : {"$ref": "#/$defs/Like"},
                "$eq"          : {"$ref": "#/$defs/Predicate"},
                "$neq"         : {"$ref": "#/$defs/Predicate"},
                "$gt"          : {"$ref": "#/$defs/Predicate"},
                "$gte"         : {"$ref": "#/$defs/Predicate"},
                "$lt"          : {"$ref": "#/$defs/Predicate"},
                "$lte"         : {"$ref": "#/$defs/Predicate"},
                "$in"          : {"$ref": "#/$defs/Predicate"},
                "$exists"      : {"$ref": "#/$defs/Predicate"},
                "$is"          : {"$ref": "#/$defs/Predicate"},
                "$similar"     : {"$ref": "#/$defs/Predicate"},
                "$between"     : {"$ref": "#/$defs/Between"},
                "$case"        : {"$ref": "#/$defs/Case"},
                "$distinctFrom": {"$ref": "#/$defs/Predicate"}
            },
            "additionalProperties": false
        },
        "LogicalExpressions": {
            "type": "array",
            "items": {"$ref": "#/$defs/LogicalExpression"}
        },
        "Between": {
            "type": "object",
            "properties": {
                "$left" : {"$ref": "#/$defs/Expressions"},
                "$upper": {"$ref": "#/$defs/Expressions"},
                "$lower": {"$ref": "#/$defs/Expressions"}
            },
            "additionalProperties": false
        },
        "Like": {
            "type": "object",
            "properties": {
                "$left"  : {"$ref": "#/$defs/Expressions"                  },
                "$right" : {"$ref": "#/$defs/Expressions"                  },
                "$escape": {                               "type": "string"}
            },
            "additionalProperties": false
        },
        "Aggregate": {
            "type": "object",
            "properties": {
                "$fn": {"type": "string"},
                "$distinct": {"type": "boolean"},
                "$orderBy": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/OrderBy"}
                },
                "$operands": {"$ref": "#/$defs/Expressions"},
                "$filter": {"$ref": "#/$defs/LogicalExpression"}
            },
            "required": ["$fn", "$operands"],
            "additionalProperties": false
        },
        "Window": {
            "type": "object",
            "properties": {
                "$fn": {"type": "string"},
                "$expressions": {"$ref": "#/$defs/Expressions"},
                "$partitionBy": {"$ref": "#/$defs/Expressions"},
                "$orderBy": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/OrderBy"}
                }
            },
            "required": ["$fn"],
            "additionalProperties": false
        },
        "Unary": {
            "type": "object",
            "properties": {
                "$fn"     : {"type": "string"                              },
                "$operand": {                  "$ref": "#/$defs/Expression"}
            },
            "required": ["$fn"],
            "additionalProperties": false
        },
        "Binary": {
            "type": "object",
            "properties": {
                "$fn": {"type": "string"},
                "$operands": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"$ref": "#/$defs/Expression"}
                }
            },
            "required": ["$fn", "$operands"],
            "additionalProperties": false
        },
        "Variadic": {
            "type": "object",
            "properties": {
                "$fn"      : {"type": "string"                               },
                "$operands": {                  "$ref": "#/$defs/Expressions"}
            },
            "required": ["$fn"],
            "additionalProperties": false
        },
        "SelectStatement": {
            "type": "object",
            "properties": {
                "$with": {"$ref": "#/$defs/With"},
                "$distinct": {"$ref": "#/$defs/Distinct"},
                "$all": {"type": "boolean"},
                "$project": {"$ref": "#/$defs/Expressions"},
                "$from": {"$ref": "#/$defs/Expressions"},
                "$join": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/Join"}
                },
                "$where": {"$ref": "#/$defs/LogicalExpression"},
                "$groupBy": {"$ref": "#/$defs/GroupBy"},
                "$having": {"$ref": "#/$defs/LogicalExpression"},
                "$orderBy": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/OrderBy"}
                },
                "$limit": {"$ref": "#/$defs/Expression"},
                "$offset": {"$ref": "#/$defs/Expression"}
            },
            "additionalProperties": false
        },
        "Distinct": {
            "type": "object",
            "properties": { "$on": {"$ref": "#/$defs/Expressions"} },
            "additionalProperties": false
        },
        "Join": {
            "type": "object",
            "properties": {
                "$expr"   : {"$ref": "#/$defs/Expression"},
                "$on"     : {"$ref": "#/$defs/LogicalExpression"},
                "$using"  : {"$ref": "#/$defs/Expressions"},
                "$inner"  : {"type": "boolean"},
                "$left"   : {"type": "boolean"},
                "$right"  : {"type": "boolean"},
                "$full"   : {"type": "boolean"},
                "$cross"  : {"type": "boolean"},
                "$natural": {"type": "boolean"},
                "$asOf"   : {"type": "boolean"},
                "$outer"  : {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "OrderBy": {
            "type": "object",
            "properties": {
                "$expr"      : {"$ref": "#/$defs/Expression"},
                "$dir"       : { "type": "string", "enum": ["ASC", "DESC"] },
                "$nullsFirst": {"type": "boolean"},
                "$nullsLast" : {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "GroupBy": {
            "type": "object",
            "properties": {
                "$expr": {"$ref": "#/$defs/Expressions"},
                "$groupingSets": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/Expressions"}
                }
            },
            "additionalProperties": false
        },
        "With": {
            "type": "object",
            "properties": {
                "$recursive": {"type": "boolean"},
                "$ctes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"$ref": "#/$defs/CTE"}
                }
            },
            "additionalProperties": false
        },
        "CTE": {
            "type": "object",
            "properties": {
                "$expr"        : {"$ref": "#/$defs/Expression"},
                "$recursive"   : {"type": "boolean"},
                "$usingKey"    : {"$ref": "#/$defs/Expressions"},
                "$materialized": {"type": "boolean"},
                "$set"         : {"$ref": "#/$defs/SetOperation"}
            },
            "additionalProperties": false
        },
        "SetOperation": {
            "type": "object",
            "properties": {
                "$union": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$unionAll": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$unionAllByName": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$intersect": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$intersectAll": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$except": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$exceptAll": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/SetOperation"}
                },
                "$select": {"$ref": "#/$defs/SelectStatement"}
            },
            "additionalProperties": false
        },
        "TableSchema": {
            "type": "object",
            "properties": {
                "name": {"type": "string"},
                "columns": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/ColumnSchema"}
                },
                "comment": {"type": "string"}
            },
            "additionalProperties": false
        },
        "ColumnSchema": {
            "type": "object",
            "properties": {
                "name"            : {"type": "string"},
                "arrayDataType"   : {"$ref": "#/$defs/DataType"},
                "dataType"        : {"$ref": "#/$defs/DataType"},
                "dataLength"      : {"type": "integer"},
                "precision"       : {"type": "integer"},
                "scale"           : {"type": "integer"},
                "ordinalPosition" : {"type": "integer"},
                "comment"         : {"type": "string"},
                "collate"         : {"type": "string"},
                "pk"              : {"type": "boolean"},
                "unique"          : {"type": "boolean"},
                "notNullable"     : {"type": "boolean"},
                "generated"       : {"$ref": "#/$defs/Expression"},
                "generatedStored" : {"type": "boolean"},
                "generatedVirtual": {"type": "boolean"},
                "default"         : {"$ref": "#/$defs/Expression"},
                "check"           : {"$ref": "#/$defs/LogicalExpression"}
            },
            "additionalProperties": false
        },
        "DataType": {
            "type": "string",
            "enum": [
                "BIGINT",
                "INT8",
                "LONG",
                "BIT",
                "BITSTRING",
                "BLOB",
                "BINARY",
                "VARBINARY",
                "BYTEA",
                "BOOLEAN",
                "BOOL",
                "LOGICAL",
                "DATE",
                "DECIMAL",
                "NUMERIC",
                "DOUBLE",
                "FLOAT8",
                "FLOAT",
                "FLOAT4",
                "REAL",
                "HUGEINT",
                "INTEGER",
                "INT",
                "INT4",
                "SIGNED",
                "INTERVAL",
                "JSON",
                "JSONB",
                "SMALLINT",
                "INT2",
                "SHORT",
                "TIME",
                "TIMESTAMPTZ",
                "TIMESTAMP WITH TIME ZONE",
                "TIMESTAMP",
                "TIMESTAMP WITHOUT TIME ZONE",
                "TIMESTAMP_S",
                "TIMESTAMP_MS",
                "TIMESTAMP_NS",
                "DATETIME",
                "TINYINT",
                "INT1",
                "UBIGINT",
                "UHUGEINT",
                "UINTEGER",
                "USMALLINT",
                "UTINYINT",
                "UUID",
                "VARCHAR",
                "STRING",
                "CHAR",
                "TEXT",
                "BPCHAR",
                "ARRAY",
                "LIST"
            ]
        }
    }
}
