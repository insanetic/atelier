{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/atlas\" hint", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/atlas\" commit --hook", "timeout": 10 }]
      }
    ]
  }
}
